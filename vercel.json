{
  "buildCommand": "npm run build:site",
  "outputDirectory": "site",
  "installCommand": "npm install",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/dist/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
